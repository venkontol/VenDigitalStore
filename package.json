{
  "name": "nexusbase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NexusBase - Telegram bot auto order NOKOS (SMSCode) di Cloudflare Workers + D1",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute nexusbase-db --local --file=./database/schema.sql",
    "db:init:remote": "wrangler d1 execute nexusbase-db --remote --file=./database/schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
