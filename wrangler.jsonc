{
  // Konfigurasi non-secret saja. Secret diatur di Cloudflare (wrangler secret put / dashboard).
  "name": "nexusbase",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexusbase-db",
      // Placeholder: ganti dengan database_id asli dari dashboard/wrangler d1 create.
      "database_id": "68cd65df-ae9a-41d1-93b7-6f2a0755913f"
    }
  ]
}
